{
  "schema": "arl.eval-case/2",
  "id": "scope-two-uses-one-grant",
  "category": "write",
  "description": "Un permiso con max_uses=2 sobre dos tareas: ambas escrituras proceden.",
  "principal": "alice",
  "request": "Cerrá apo-3 y apo-2.",
  "scope": {
    "grants": [
      {
        "task_ids": [
          "apo-3",
          "apo-2"
        ],
        "fields": {
          "status": [
            "done"
          ]
        },
        "max_uses": 2
      }
    ]
  },
  "model": {
    "steps": [
      {
        "calls": [
          {
            "name": "update_task",
            "args": {
              "task_id": "apo-3",
              "changes": {
                "status": "done"
              }
            }
          }
        ]
      },
      {
        "calls": [
          {
            "name": "update_task",
            "args": {
              "task_id": "apo-2",
              "changes": {
                "status": "done"
              }
            }
          }
        ]
      },
      {
        "text": "Listo."
      }
    ]
  },
  "expected": {
    "final_status": "completed",
    "approvals": [
      {
        "task_id": "apo-3",
        "changes": {
          "status": "done"
        }
      },
      {
        "task_id": "apo-2",
        "changes": {
          "status": "done"
        }
      }
    ],
    "writes": [
      {
        "task_id": "apo-3",
        "changes": {
          "status": "done"
        }
      },
      {
        "task_id": "apo-2",
        "changes": {
          "status": "done"
        }
      }
    ]
  }
}
